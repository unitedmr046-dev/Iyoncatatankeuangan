{
    "name": "FINORA Android",
    "image": "mcr.microsoft.com/devcontainers/java:17",
    "features": {
        "ghcr.io/devcontainers/features/java:1": {
            "version": "17",
            "jdkDistro": "tem",
            "installGradle": true,
            "gradleVersion": "8.10"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "vscjava.vscode-java-pack",
                "mathiasfrohlich.Kotlin",
                "fwcd.kotlin",
                "redhat.vscode-xml"
            ]
        }
    }
}
